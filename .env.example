# cp .env.example .env   and edit. Read by docker compose.

# ONE GPU index from `nvidia-smi` that nobody else is using (only one V100 is used)
GPU_ID=0

# Host port; the API listens on 127.0.0.1 only unless BIND_ADDR=0.0.0.0 (ask the user first)
HOST_PORT=8080
BIND_ADDR=127.0.0.1

# torch CUDA build: cu126 if the driver is >= 525.60.13, else cu118 (CLAUDE.md step 2)
TORCH_INDEX=cu126

# auto = GPU if XGBoost can use it, else CPU (both give the same scores)
XGB_DEVICE=auto

# Leave empty to use artifacts/manifest.json "threshold" (0.25)
FRAUD_THRESHOLD=

MAX_BATCH=1000
LOG_LEVEL=INFO
